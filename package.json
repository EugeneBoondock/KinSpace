{
  "name": "kin-space",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed-conditions.ts",
    "research:generate": "curl -X POST http://localhost:3000/api/research/generate?max=6",
    "cf:patch": "node scripts/patch-opennext.js",
    "cf:build": "node scripts/patch-opennext.js && opennextjs-cloudflare build",
    "cf:preview": "node scripts/patch-opennext.js && opennextjs-cloudflare build && node scripts/patch-worker-scheduled.js && opennextjs-cloudflare preview",
    "cf:deploy": "node scripts/patch-opennext.js && opennextjs-cloudflare build && node scripts/patch-worker-scheduled.js && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply kinspace --local",
    "db:migrate": "wrangler d1 migrations apply kinspace --remote",
    "db:seed:local": "wrangler d1 execute kinspace --local --file=drizzle/seed.sql",
    "db:seed": "wrangler d1 execute kinspace --remote --file=drizzle/seed.sql",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@opennextjs/cloudflare": "^1.19.11",
    "@pushforge/builder": "^2.0.5",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@types/leaflet": "^1.9.21",
    "chess.js": "^1.4.0",
    "drizzle-orm": "^0.45.2",
    "js-chess-engine": "^1.0.2",
    "leaflet": "^1.9.4",
    "next": "^15.5.19",
    "openai": "^6.34.0",
    "react": "^19.0.0",
    "react-chessboard": "^5.10.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-tetris": "^0.4.0",
    "recharts": "^2.8.0",
    "rss-parser": "^3.13.0",
    "slugify": "^1.6.9",
    "sudoku": "^0.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260617.1",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.12.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.2.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wrangler": "^4.102.0"
  }
}
