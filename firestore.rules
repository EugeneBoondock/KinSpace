rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Profiles: users can read any profile, write only their own
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // Community posts
    match /community_posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update: if request.auth != null;
    }

    match /post_likes/{likeId} {
      allow read, create, delete: if request.auth != null;
    }

    match /post_reactions/{reactionId} {
      allow read, create, delete: if request.auth != null;
    }

    match /post_comments/{commentId} {
      allow read, create: if request.auth != null;
    }

    // Chat messages
    match /chat_messages/{messageId} {
      allow read, create: if request.auth != null;
    }

    // Groups
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    match /group_members/{memberId} {
      allow read, create: if request.auth != null;
    }

    // Games
    match /games/{gameId} {
      allow read, create, update: if request.auth != null;
    }

    match /game_players/{playerId} {
      allow read, create: if request.auth != null;
    }

    // Angels
    match /angels/{angelId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
    }

    match /angel_soul_relationships/{relationshipId} {
      allow read, create: if request.auth != null;
    }

    // Mentors
    match /mentors/{mentorId} {
      allow read, create, update: if request.auth != null;
    }

    // Activities
    match /community_activities/{activityId} {
      allow read, create, update: if request.auth != null;
    }

    match /activity_members/{memberId} {
      allow read, create: if request.auth != null;
    }

    // Support directory
    match /support_locations/{locationId} {
      allow read, create, update: if request.auth != null;
    }

    // Research & resources — reads public to signed-in users; writes mostly server-side via Admin SDK
    match /resources/{resourceId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
    }

    match /research_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update: if request.auth != null;
    }

    match /resource_contributions/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }

    match /resource_contribution_votes/{id} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    // Connection requests
    match /connection_requests/{requestId} {
      allow read, create, update: if request.auth != null;
    }

    // Encryption keys
    match /encryption_keys/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // StuffThatWorks-style insights
    match /conditions/{slug} {
      allow read: if request.auth != null;
      allow update: if request.auth != null;
    }

    match /treatments/{slug} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
    }

    match /condition_treatments/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /experiences/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }

    match /experience_votes/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    match /symptoms/{slug} {
      allow read: if request.auth != null;
    }

    match /condition_symptoms/{id} {
      allow read: if request.auth != null;
    }

    match /triggers/{slug} {
      allow read: if request.auth != null;
    }

    match /condition_triggers/{id} {
      allow read: if request.auth != null;
    }

    // Ask (symptom + health questions)
    match /ask_questions/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }

    match /ask_answers/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }

    match /ask_answer_votes/{id} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    // Daily mood check-ins (owner only — server API reads with Admin SDK)
    match /mood_checkins/{id} {
      allow read, write: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    // Therapy sessions — owner read + create; server API summarises via Admin SDK
    match /therapy_sessions/{id} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }
  }
}
